# WALLET_CONNECT_PROJECT_ID: Required for the WalletConnect (Reown AppKit) integration.
# Create a free Project ID at https://cloud.reown.com/
# Used by src/services/wallet/ to power the Connect Wallet button and
# the review bounty payment flow on Ethereum Sepolia.
WALLET_CONNECT_PROJECT_ID="MY_WALLET_CONNECT_PROJECT_ID"

# VITE_DAIO_API: DAIO Content Service base URL. Powers relayed USDAIO request
# creation, document storage, agent status / reasons, and the /ask interview
# endpoint. Production reverse-proxies api.opendaio.com:80 → localhost:18002.
VITE_DAIO_API=http://api.opendaio.com

# VITE_MARKITDOWN_API: MarkItDown API base URL. Used by the submission gate to
# convert PDF/DOCX uploads into Markdown before relayed request creation.
# Production reverse-proxies markitdown.opendaio.com:80 → localhost:18003.
VITE_MARKITDOWN_API=http://markitdown.opendaio.com
